        {
          "name": "Cadastrar turma",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/turmas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "turmas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"codigo\": \"POO01\",\n    \"nomeDisciplina\": \"Programação Orientada a Objetos\",\n    \"professorId\": 1,\n    \"semestre\": \"2026/2\",\n    \"sala\": \"Lab 05\",\n    \"diasSemana\": [\n        \"SEXTA\"\n    ],\n    \"horarioInicial\": \"19:00\",\n    \"horarioFinal\": \"22:15\",\n    \"cargaHoraria\": 60,\n    \"numeroVagas\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201. Confere o professorId no Cadastro. Executar duas vezes devolve 400 (código duplicado)."
          },
          "response": []
        },
        {
          "name": "Atualizar turma (parcial)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/turmas/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "turmas",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"sala\": \"Lab 03\",\n    \"numeroVagas\": 40\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Atualiza só os campos enviados. 200."
          },
          "response": []
        },
        {
          "name": "Remover turma",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/turmas/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "turmas",
                "3"
              ]
            },
            "description": "204. Consulta o serviço de Matrículas: 409 se houver matrícula ATIVA, 503 se Matrículas estiver fora do ar."
          },
          "response": []
        }
      ]
    },
